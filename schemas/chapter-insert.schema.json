{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jed-video-system:chapter-insert:0.1.0",
  "title": "Explicit sentence-boundary chapter insertions for the 30fps pilot",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "sourceBoundaryFrame", "durationInFrames", "placement", "audioPolicy", "boundaryEvidence", "title", "number", "artSrc", "styleId", "styleRevision", "sound"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "sourceBoundaryFrame": {"type": "integer", "minimum": 1},
      "durationInFrames": {"type": "integer", "minimum": 36, "maximum": 90},
      "placement": {"const": "insert_hold"},
      "audioPolicy": {"const": "pause_source"},
      "boundaryEvidence": {
        "type": "object", "required": ["kind", "before", "after"],
        "properties": {
          "kind": {"const": "between_sentences"},
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string", "minLength": 1}
        }
      },
      "title": {"type": "string", "minLength": 1},
      "number": {"type": "string", "minLength": 1},
      "artSrc": {"type": "string", "minLength": 1},
      "styleId": {"type": "string", "minLength": 1},
      "styleRevision": {"type": "string", "minLength": 1},
      "sound": {
        "type": "object", "required": ["audioSrc", "offsetFrames", "durationInFrames", "volume"],
        "properties": {
          "audioSrc": {"type": "string", "minLength": 1},
          "offsetFrames": {"type": "integer", "minimum": 0},
          "durationInFrames": {"type": "integer", "minimum": 1, "maximum": 90},
          "volume": {"const": 1}
        }
      }
    }
  },
  "$comment": "Python additionally validates ordered source boundaries, source preservation, caption/animation edges, and that each sound ends within its chapter gap. Evidence text is supplied and checked by the host, not semantically authenticated by this schema."
}
