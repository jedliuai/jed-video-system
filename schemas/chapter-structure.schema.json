{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jed-video-system:chapter-structure:0.1.0",
  "type": "object",
  "required": ["schemaVersion", "projectId", "source", "sourcePropsSha256", "style", "sections"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "projectId": {"type": "string", "minLength": 1},
    "sourcePropsSha256": {"$ref": "#/$defs/digest"},
    "source": {"type": "object", "required": ["publicFile", "mediaSha256", "fps", "durationInFrames"], "properties": {
      "publicFile": {"type": "string", "minLength": 1}, "mediaSha256": {"$ref": "#/$defs/digest"},
      "fps": {"const": 30}, "durationInFrames": {"type": "integer", "minimum": 1}
    }},
    "style": {"type": "object", "required": ["id", "revision", "referenceAsset", "referenceSha256", "imageBackend"], "properties": {
      "id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
      "referenceAsset": {"type": "string", "minLength": 1}, "referenceSha256": {"$ref": "#/$defs/digest"},
      "imageBackend": {"type": "string", "minLength": 1}
    }},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "startFrame", "endFrame", "title", "summary", "evidence"], "properties": {
      "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["context", "overview", "explanation", "demonstration", "summary"]},
      "startFrame": {"type": "integer", "minimum": 0}, "endFrame": {"type": "integer", "minimum": 1},
      "title": {"type": "string", "minLength": 1, "maxLength": 12}, "summary": {"type": "string", "minLength": 1},
      "evidence": {"type": "object", "required": ["quote", "atFrame", "confidence"], "properties": {
        "quote": {"type": "string", "minLength": 1}, "atFrame": {"type": "integer", "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }},
      "bridge": {"type": "object", "required": ["kind", "startFrame", "endFrame"], "properties": {
        "kind": {"const": "spoken_bridge"}, "startFrame": {"type": "integer", "minimum": 0}, "endFrame": {"type": "integer", "minimum": 1}
      }},
      "transition": {"type": "object", "required": ["number", "durationInFrames", "placement", "audioPolicy"], "properties": {
        "number": {"type": "string", "pattern": "^[0-9]{2}$"}, "durationInFrames": {"type": "integer", "minimum": 36, "maximum": 90},
        "placement": {"const": "cover_bridge"}, "audioPolicy": {"const": "continue_source"}
      }}
    }, "allOf": [{"if": {"required": ["transition"]}, "then": {"required": ["bridge"]}}]}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
